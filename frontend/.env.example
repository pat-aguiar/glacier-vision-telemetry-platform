# API and WebSocket configurations for the frontend
VITE_TELEMETRY_STREAM_URL=ws://localhost:8000/api/v1/telemetry/stream
VITE_API_BASE_URL=http://localhost:8000

# Must match the backend's DASHBOARD_ACCESS_TOKEN (see the root .env.example) --
# sent as the X-Dashboard-Token header and WS ?token= param to authenticate
# dashboard read requests (image lookup, the live stream).
VITE_DASHBOARD_ACCESS_TOKEN=replace-with-a-strong-generated-secret
