# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL password — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-strong-generated-secret

# Async database connection URL — must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql+asyncpg://telemetry:replace-with-a-strong-generated-secret@localhost:5432/telemetry

CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
