# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL password — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-strong-generated-secret

# Async database connection URL — must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql+asyncpg://telemetry:replace-with-a-strong-generated-secret@localhost:5432/telemetry

CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# API key edge sorting devices must send to POST telemetry events —
# generate with: openssl rand -base64 32
EDGE_API_KEY=replace-with-a-strong-generated-secret

# Access token the dashboard frontend uses for read endpoints (image lookup,
# the live stream) — generate with: openssl rand -base64 32
DASHBOARD_ACCESS_TOKEN=replace-with-a-strong-generated-secret

# Rate limit applied to POST /api/v1/telemetry/events, "<count>/<period>"
# syntax (e.g. "100/minute", "10/second").
TELEMETRY_EVENTS_RATE_LIMIT=100/minute
